      "lineRange": [34, 34],
      "summary": "Copyable newtype wrapping a monotonically increasing usize that uniquely identifies a spawned future; used in tests to await specific spawned futures.",
      "tags": ["identifier", "newtype", "async", "future"],
      "complexity": "simple"
    },
