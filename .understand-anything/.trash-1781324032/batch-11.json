      "summary": "Multi-threaded background executor wrapping a tokio runtime built with a custom worker count and thread-name function; spawns Send futures and supports abortable tasks.",
      "tags": ["executor", "async", "tokio", "threadpool", "concurrency"],
      "complexity": "moderate"
    },
