{
  "nodes": [
    {
      "id": "file:crates/warpui_core/src/async/mod.rs",
      "type": "file",
      "name": "mod.rs",
      "filePath": "crates/warpui_core/src/async/mod.rs",
      "summary": "Cross-platform async facade for warpui_core: selects the native or wasm executor implementation via cfg, re-exports the executor/spawning API, and defines core async primitives like FutureId, SpawnedFutureHandle, and the FutureExt::with_timeout extension.",
      "tags": ["async", "executor", "cross-platform", "future", "barrel"],
      "complexity": "moderate",
      "languageNotes": "Uses cfg_if to swap between `native` and `wasm` submodules behind a shared `imp` alias; a blanket `impl<F: Future> FutureExt for F` adds `with_timeout` to every future."
    },
    {
      "id": "file:crates/warpui_core/src/async/native/executor.rs",
      "type": "file",
      "name": "executor.rs",
      "filePath": "crates/warpui_core/src/async/native/executor.rs",
      "summary": "Native executor implementation providing the Foreground main-thread executor and a multi-threaded tokio-backed Background runtime, with abortable task spawning and tracing span instrumentation.",
      "tags": ["executor", "async", "tokio", "concurrency", "task-spawning"],
      "complexity": "complex",
      "languageNotes": "Foreground runs tasks on the main thread via async_task::spawn_local with a custom schedule that re-dispatches through the platform delegate; Background wraps a tokio multi-thread runtime built with a custom worker count and thread-name function."
    },
    {
      "id": "file:crates/warpui_core/src/async/native/mod.rs",
      "type": "file",
      "name": "mod.rs",
      "filePath": "crates/warpui_core/src/async/native/mod.rs",
      "summary": "Native async module root: re-exports async_io's block_on/Timer and the executor submodule, and defines the Send-bounded Spawnable/Stream/SpawnableOutput/TransportStream trait aliases required by the multi-threaded runtime.",
      "tags": ["barrel", "async", "type-definition", "native", "re-export"],
      "complexity": "simple",
      "languageNotes": "Uses `trait_set!` to declare trait aliases; native variants require `Send` bounds for the multi-threaded tokio executor."
    },
    {
      "id": "file:crates/warpui_core/src/async/wasm/executor.rs",
      "type": "file",
      "name": "executor.rs",
      "filePath": "crates/warpui_core/src/async/wasm/executor.rs",
      "summary": "WASM executor implementation where all tasks are local (no background threads): provides Foreground and Background executors backed by wasm_bindgen_futures spawn_local, with abortable spawning.",
      "tags": ["executor", "async", "wasm", "concurrency", "task-spawning"],
      "complexity": "moderate",
      "languageNotes": "On wasm every future runs on the single main thread, so Background simply delegates to local spawning and tasks are non-Send."
    },
    {
      "id": "file:crates/warpui_core/src/async/wasm/mod.rs",
      "type": "file",
      "name": "mod.rs",
      "filePath": "crates/warpui_core/src/async/wasm/mod.rs",
      "summary": "WASM async module root: re-exports block_on and a gloo-timers-backed Timer that mirrors async_io::Timer, and defines relaxed (non-Send) trait aliases for spawnable tasks/streams on the single-threaded wasm runtime.",
      "tags": ["barrel", "async", "wasm", "timer", "type-definition"],
      "complexity": "moderate",
      "languageNotes": "Provides a custom Timer wrapping gloo TimeoutFuture and implementing both Future and Stream; trait aliases drop the Send bound since wasm is single-threaded."
    },
    {
      "id": "class:crates/warpui_core/src/async/mod.rs:FutureId",
